# Copy to `.env.staging.local` (gitignored) and point it at an environment you control.
# Never put real keys in this example file.
#
#   cp .env.staging.example .env.staging.local
#
# When `E2E_BASE_URL` is empty the suite runs against the bundled demo app
# (`demo/`), so `pnpm test` works on a fresh clone with no setup.

# --- Environment under test -------------------------------------------------
# Leave blank to use the bundled demo app on http://127.0.0.1:4173
E2E_BASE_URL=
# Passcode the suite logs in with. Required whenever E2E_BASE_URL is set.
E2E_PASSCODE=

# --- Guardrails -------------------------------------------------------------
# `scripts/qa/db-guard.mjs` refuses to run when the target matches either of
# these, so a misconfigured environment fails closed instead of writing to live
# data. Leave blank when there is nothing to protect.
PROD_BASE_URL=
PROD_PROJECT_REF=

# --- Database (optional, API tests only) ------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
