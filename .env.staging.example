NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Production ref — db-guard will refuse any command targeting this project
PROD_PROJECT_REF=fkwqoljqftmcoddvochh

# App under test
E2E_BASE_URL=http://localhost:3000
E2E_PASSCODE=change-me-staging-passcode
